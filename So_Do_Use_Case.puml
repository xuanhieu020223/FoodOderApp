@startuml
title Use Case Diagram - Food Order App

!define RECTANGLE class
left to right direction

skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #555555
}

'======================
' Actors
'======================
actor "Khách hàng" as Customer
actor "Nhà hàng" as Restaurant
actor "Tài xế/Shipper" as Shipper
actor "Quản trị viên" as Admin
actor "Firebase/Auth" as Firebase
actor "Cổng thanh toán" as PaymentGateway
actor "Google Maps" as Maps
actor "AI Services\n(Chatbot/Recommender)" as AIService

'======================
' Systems / Packages
'======================
rectangle "Ứng dụng di động" {
  package "Customer App" {
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Đăng nhập" as UC_Login
    usecase "Quản lý hồ sơ\n& cài đặt" as UC_Profile
    usecase "Quản lý địa chỉ" as UC_Address
    usecase "Quản lý thanh toán" as UC_Payment
    usecase "Tìm kiếm & duyệt\nnhà hàng/món" as UC_Browse
    usecase "Quản lý giỏ hàng" as UC_Cart
    usecase "Đặt món & thanh toán" as UC_Order
    usecase "Theo dõi đơn hàng" as UC_TrackOrder
    usecase "Quản lý voucher" as UC_Voucher
    usecase "Đánh giá nhà hàng\n/tài xế/món" as UC_Review
    usecase "Nhận thông báo" as UC_Notifications
    usecase "Liên hệ hỗ trợ\n(FAQ/Ticket)" as UC_Support
    usecase "Chat với AI" as UC_Chatbot
  }

  package "Restaurant App" {
    usecase "Đăng nhập nhà hàng" as UC_R_Login
    usecase "Quản lý nhà hàng\n(thông tin, nhân sự)" as UC_R_Profile
    usecase "Quản lý danh mục\n& món ăn" as UC_R_Menu
    usecase "Quản lý đơn hàng" as UC_R_Orders
    usecase "Quản lý khuyến mãi" as UC_R_Promo
    usecase "Xem báo cáo doanh thu" as UC_R_Report
    usecase "Giải quyết hỗ trợ" as UC_R_Support
  }

  package "Shipper App" {
    usecase "Đăng nhập shipper" as UC_S_Login
    usecase "Quản lý hồ sơ shipper" as UC_S_Profile
    usecase "Nhận đơn giao hàng" as UC_S_Assign
    usecase "Điều hướng giao hàng" as UC_S_Navigate
    usecase "Cập nhật trạng thái giao" as UC_S_UpdateStatus
    usecase "Quản lý thu nhập" as UC_S_Finance
    usecase "Nhận thông báo giao" as UC_S_Notifications
  }
}

rectangle "Admin Portal" {
  usecase "Đăng nhập admin" as UC_A_Login
  usecase "Quản lý người dùng" as UC_A_Users
  usecase "Quản lý danh mục & đơn" as UC_A_Orders
  usecase "Quản lý khuyến mãi" as UC_A_Promo
  usecase "Xem báo cáo & phân tích" as UC_A_Report
  usecase "Quản lý ticket hỗ trợ" as UC_A_Support
  usecase "Cấu hình hệ thống" as UC_A_Config
}

'======================
' Relationships: Customers
'======================
Customer --> UC_Register
Customer --> UC_Login
Customer --> UC_Profile
Customer --> UC_Address
Customer --> UC_Payment
Customer --> UC_Browse
Customer --> UC_Cart
Customer --> UC_Order
Customer --> UC_TrackOrder
Customer --> UC_Voucher
Customer --> UC_Review
Customer --> UC_Notifications
Customer --> UC_Support
Customer --> UC_Chatbot

UC_Order ..> UC_Cart : <<include>>
UC_Order ..> UC_Payment : <<include>>
UC_Order ..> UC_Address : <<include>>
UC_Order ..> UC_Voucher : <<extend>>
UC_TrackOrder ..> UC_Notifications : <<include>>
UC_Chatbot ..> AIService : <<include>>

'======================
' Relationships: Restaurants
'======================
Restaurant --> UC_R_Login
Restaurant --> UC_R_Profile
Restaurant --> UC_R_Menu
Restaurant --> UC_R_Orders
Restaurant --> UC_R_Promo
Restaurant --> UC_R_Report
Restaurant --> UC_R_Support

UC_R_Orders ..> UC_R_Menu : <<include>>
UC_R_Promo ..> UC_R_Menu : <<extend>>
UC_R_Report ..> UC_R_Orders : <<include>>

'======================
' Relationships: Shippers
'======================
Shipper --> UC_S_Login
Shipper --> UC_S_Profile
Shipper --> UC_S_Assign
Shipper --> UC_S_Navigate
Shipper --> UC_S_UpdateStatus
Shipper --> UC_S_Finance
Shipper --> UC_S_Notifications

UC_S_Assign ..> UC_S_UpdateStatus : <<include>>
UC_S_Navigate ..> Maps : <<include>>
UC_S_UpdateStatus ..> UC_S_Notifications : <<extend>>

'======================
' Relationships: Admin
'======================
Admin --> UC_A_Login
Admin --> UC_A_Users
Admin --> UC_A_Orders
Admin --> UC_A_Promo
Admin --> UC_A_Report
Admin --> UC_A_Support
Admin --> UC_A_Config

UC_A_Orders ..> UC_A_Users : <<include>>
UC_A_Promo ..> UC_A_Users : <<extend>>
UC_A_Report ..> UC_A_Orders : <<include>>
UC_A_Support ..> UC_A_Users : <<include>>

'======================
' External integrations
'======================
UC_Register --> Firebase : <<include>>
UC_Login --> Firebase : <<include>>
UC_R_Login --> Firebase
UC_S_Login --> Firebase
UC_A_Login --> Firebase

UC_Order --> PaymentGateway : <<include>>
UC_Order --> Maps : <<extend>>\n"Ước tính phí giao""
UC_TrackOrder --> Maps : <<include>>
UC_TrackOrder --> Shipper : <<include>>
UC_S_Navigate --> UC_TrackOrder : <<include>>
UC_Order --> UC_R_Orders : <<include>>
UC_R_Orders --> UC_S_Assign : <<include>>

UC_Notifications --> Firebase : <<include>>
UC_S_Notifications --> Firebase

UC_Support --> UC_A_Support : <<include>>
UC_R_Support --> UC_A_Support : <<include>>

UC_Voucher --> UC_R_Promo : <<include>>
UC_Voucher --> UC_A_Promo : <<extend>>

@enduml

